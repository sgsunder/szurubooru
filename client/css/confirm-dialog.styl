@import colors

.confirm-dialog-overlay
    position: fixed
    top: 0
    left: 0
    right: 0
    bottom: 0
    display: flex
    align-items: center
    justify-content: center
    background: rgba(0, 0, 0, 0.5)
    z-index: 2000

.confirm-dialog
    box-sizing: border-box
    max-width: 32em
    max-height: 80vh
    overflow-y: auto
    margin: 1em
    padding: 1.5em
    background: $window-color
    color: $text-color
    border: 1px solid $line-color
    border-radius: 3px
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3)

    .confirm-dialog-text
        margin: 0 0 1em 0

    .confirm-dialog-mono
        margin: 0 0 1em 0
        padding: 0.5em 0.75em
        overflow-x: auto
        white-space: pre-wrap
        word-break: break-word
        font-family: Consolas, Monaco, 'Courier New', monospace
        font-size: 0.9em
        background: $input-enabled-background-color
        border: 1px solid $input-enabled-border-color
        border-radius: 2px

    .confirm-dialog-buttons
        display: flex
        justify-content: flex-end
        > *
            margin-left: 0.5em

        button
            font-family: inherit
            font-size: 1em
            padding: 0.4em 1.2em
            border-radius: 2px
            cursor: pointer

        .confirm-dialog-confirm
            border: 1px solid $button-enabled-background-color
            background: $button-enabled-background-color
            color: $button-enabled-text-color

        .confirm-dialog-cancel
            border: 1px solid $line-color
            background: transparent
            color: $text-color

.darktheme .confirm-dialog
    background: $window-color-darktheme
    color: $text-color-darktheme
    border-color: lighten($window-color-darktheme, 20%)

    .confirm-dialog-mono
        background: darken($window-color-darktheme, 10%)
        border-color: lighten($window-color-darktheme, 15%)

    .confirm-dialog-buttons
        .confirm-dialog-cancel
            border-color: lighten($window-color-darktheme, 25%)
            color: $text-color-darktheme
